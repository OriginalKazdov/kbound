// Cedar policy — recovered linear residual rule.
// Generated by Kazdov Spec. Use as documentation + drift-detection
// anchor for Microsoft Agent Governance Toolkit and similar.
@kazdov_recovered_rule(
  family: "linear_residual_policy",
  formula: "(19 * x + 11) mod 23",
  parameters: { a: 19, c: 11, m: 23 },
  emitted_by: "kazdov_spec.synth.synthesize_replacement"
)
permit (
  principal,
  action == Action::"emit_decision",
  resource
);
